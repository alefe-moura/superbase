# =====================================================================
# SuperBase Manager, variaveis de ambiente
# Copie para .env.local (desenvolvimento) e replique nas env vars da Vercel.
# Gere os segredos com: npm run genkey
# =====================================================================

# --- Projeto Supabase do sistema (DEDICADO a este app) ----------------
# NAO use aqui um projeto de cliente. Crie um projeto novo so para o sistema.
# Os tres valores estao em: Project Settings > API
SYSTEM_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key (secreta), usada para ler e escrever os dados do app.
SYSTEM_SUPABASE_SERVICE_KEY=

# anon key (publica), usada apenas para o login via Supabase Auth.
SYSTEM_SUPABASE_ANON_KEY=

# --- Quem pode entrar -------------------------------------------------
# Lista de e-mails autorizados, separados por virgula. Segunda tranca alem
# de desabilitar o cadastro publico no painel do Supabase.
# Sem esta variavel preenchida, NINGUEM entra (falha fechada, de proposito).
ALLOWED_EMAILS=voce@exemplo.com

# --- Cofre de credenciais ---------------------------------------------
# 32 bytes em base64. Criptografa PATs e chaves dos clientes (AES-256-GCM).
# PERDER ESTA CHAVE = PERDER TODAS AS CREDENCIAIS SALVAS. Faca backup dela.
APP_ENCRYPTION_KEY=

# --- Monitoramento ----------------------------------------------------
# Autoriza o Vercel Cron a disparar a coleta de snapshots.
CRON_SECRET=
SNAPSHOT_RETENTION_DAYS=30

# Por quantos dias os backups sao mantidos (padrao 30).
# O backup mais recente de cada projeto nunca e apagado, mesmo que passe disso.
BACKUP_RETENTION_DAYS=30
